{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-native",
    "module": "es2020",
    "moduleResolution": "bundler",
    "types": ["jest", "node", "react"],
    "skipLibCheck": true
  },
  "exclude": [
    "src/lib/sandbox/runtime",
    "scripts",
    "__tests__",
    "node_modules",
    "android",
    "ios",
    ".expo"
  ]
}
